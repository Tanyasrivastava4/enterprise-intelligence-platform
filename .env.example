# ==============================================================================
# Enterprise Intelligence Platform - Environment Configuration Example
# ==============================================================================

# Project & App Settings
PROJECT_NAME="Enterprise Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-char-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite (Async). For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/enterprise_db
DATABASE_URL="sqlite+aiosqlite:///./data/enterprise.db"

# LLM Providers (Multi-Model Resilience & Fallback)
# Primary: Groq (Llama-3.3-70b-versatile or Mixtral-8x7b)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Secondary / Fallback: Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional Alternative: OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Embedding Model
# Uses sentence-transformers local model by default (no external API calls or costs required)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Vector Store
CHROMA_PERSIST_DIR="./data/chroma_storage"

# Ingestion Settings
UPLOAD_DIR="./data/uploads"
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25

# Agent Safeguards
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=45
SIMILARITY_THRESHOLD=0.45
